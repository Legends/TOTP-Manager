<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource AppTitle}"
    Width="320"
    Height="520"
    MinWidth="300"
    MinHeight="200"
    WindowStartupLocation="CenterScreen"
    Icon="/Assets/Icons/app.ico">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding BeginAddAccountCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding BeginEditAccountCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeleteAccountCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    </Window.KeyBindings>

    <shared:BusyOverlay
        BusyMessage="{DynamicResource StartingSafely}"
        IsBusy="{Binding IsBusy}">
        <Grid Background="{DynamicResource BrushWindowBackground}">

            <!-- Locked and first-run presentation mirrors the compact WPF gate. -->
            <Grid
                Margin="20"
                IsVisible="{Binding !IsShellVisible}">
                <StackPanel
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Image
                        Width="54"
                        Height="54"
                        HorizontalAlignment="Center"
                        Source="/Assets/Icons/app.ico" />
                    <TextBlock
                        automation:AutomationProperties.HeadingLevel="1"
                        Classes="app-title"
                        HorizontalAlignment="Center"
                        Text="{DynamicResource AppHeading}" />
                    <shared:NotificationBanner
                        Severity="{Binding StatusSeverity}"
                        Text="{Binding StatusText}" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding InitializeCommand}"
                        Content="{DynamicResource Retry}"
                        IsVisible="{Binding CanRetry}" />

                    <Border Classes="unlock-card" IsVisible="{Binding IsQuickUnlockVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="{DynamicResource QuickUnlock}" />
                            <TextBlock
                                Classes="secondary"
                                Text="{DynamicResource QuickUnlockRecoveryNotice}"
                                TextWrapping="Wrap" />
                            <shared:ValidationMessage
                                Severity="Error"
                                Text="{Binding QuickUnlockMessage}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsQuickUnlockBusy}" />
                            <Button
                                Classes="primary wide"
                                Command="{Binding QuickUnlockCommand}"
                                Content="{DynamicResource UnlockWithQuickUnlock}" />
                            <Button
                                Classes="link wide"
                                Command="{Binding UsePasswordFallbackCommand}"
                                Content="{DynamicResource UseMasterPassword}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordUnlockVisible}">
                        <ContentControl Content="{Binding PasswordUnlock}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Classes="section-title"
                                            Text="{DynamicResource MasterPassword}" />
                                        <shared:ValidationMessage
                                            Severity="Error"
                                            Text="{Binding Message}" />
                                        <shared:RevealableSecretInput
                                            AccessibleName="{DynamicResource MasterPassword}"
                                            HelpText="{DynamicResource MasterPasswordHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource MasterPassword}"
                                            Text="{Binding Password, Mode=TwoWay}" />
                                        <Button
                                            Classes="primary wide"
                                            Command="{Binding UnlockCommand}"
                                            Content="{DynamicResource Unlock}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordSetupVisible}">
                        <ContentControl Content="{Binding PasswordSetup}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:PasswordSetupViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Classes="section-title"
                                            Text="{DynamicResource CreatePasswordHeading}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Classes="secondary"
                                            Text="{DynamicResource PasswordSetupHelp}"
                                            TextWrapping="Wrap" />
                                        <shared:RevealableSecretInput
                                            AccessibleName="{DynamicResource NewPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource NewPassword}"
                                            Text="{Binding Password, Mode=TwoWay}" />
                                        <shared:RevealableSecretInput
                                            AccessibleName="{DynamicResource ConfirmPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource ConfirmPassword}"
                                            Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                        <shared:ValidationMessage Severity="Error" Text="{Binding Message}" />
                                        <Button
                                            Classes="primary wide"
                                            Command="{Binding ConfigureCommand}"
                                            Content="{DynamicResource CreateVault}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Authorized shell follows the compact WPF toolbar/list/code hierarchy. -->
            <Grid
                RowDefinitions="Auto,*"
                IsVisible="{Binding IsShellVisible}">
                <Border Grid.Row="0" Classes="toolbar" IsEnabled="{Binding !IsSettingsVisible}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,64,Auto,Auto">
                        <Button
                            Grid.Column="0"
                            Classes="icon"
                            Command="{Binding ScanQrCommand}"
                            ToolTip.Tip="{DynamicResource ScanQrCamera}">
                            <shared:SymbolIcon IconSize="16" Kind="Camera" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Classes="icon"
                            Command="{Binding BeginAddAccountCommand}"
                            ToolTip.Tip="{DynamicResource AddAccount}">
                            <shared:SymbolIcon IconSize="16" Kind="Add" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Classes="icon"
                            Click="FocusAccountSearch"
                            Command="{Binding ToggleSearchCommand}"
                            ToolTip.Tip="{DynamicResource SearchAccounts}">
                            <shared:SymbolIcon IconSize="16" Kind="Search" />
                        </Button>
                        <Grid
                            Grid.Column="3"
                            Margin="4,0"
                            ColumnDefinitions="*,Auto"
                            IsVisible="{Binding IsSearchVisible}">
                            <TextBox
                                x:Name="AccountSearchBox"
                                Grid.ColumnSpan="2"
                                MinWidth="72"
                                MinHeight="28"
                                Padding="7,2,22,2"
                                automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                Classes="search"
                                PlaceholderText="{DynamicResource SearchAccounts}"
                                Text="{Binding AccountList.SearchText, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                Margin="0,0,2,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Classes="link"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                IsVisible="{Binding AccountList.HasSearchText}" />
                        </Grid>
                        <ComboBox
                            Grid.Column="4"
                            Width="64"
                            MinHeight="28"
                            Padding="2"
                            HorizontalContentAlignment="Center"
                            ItemsSource="{Binding SettingsPage.Languages}"
                            SelectedItem="{Binding SettingsPage.SelectedLanguage, Mode=TwoWay}"
                            ToolTip.Tip="{DynamicResource Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="localization:LanguageOption">
                                    <Image
                                        Width="24"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Source="{Binding Icon}"
                                        Stretch="Uniform"
                                        ToolTip.Tip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Grid.Column="5"
                            Classes="icon"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="{DynamicResource Settings}">
                            <shared:SymbolIcon IconSize="16" Kind="Settings" />
                        </Button>
                        <Button
                            Grid.Column="6"
                            Classes="icon"
                            Command="{Binding LockCommand}"
                            ToolTip.Tip="{DynamicResource Lock}">
                            <shared:SymbolIcon IconSize="16" Kind="Lock" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding AccountList}" IsVisible="{Binding IsAccountListVisible}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:AccountListViewModel">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="AccountPageScrollViewer"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel
                                            x:Name="AccountPageContent"
                                            Margin="10,8,10,12"
                                            Spacing="8">
                                            <TextBlock
                                                Margin="0,28"
                                                HorizontalAlignment="Center"
                                                Classes="secondary"
                                                IsVisible="{Binding HasNoAccounts}"
                                                Text="{DynamicResource NoEntriesYet}" />
                                            <TextBlock
                                                Margin="0,28"
                                                HorizontalAlignment="Center"
                                                Classes="secondary"
                                                IsVisible="{Binding HasNoSearchResults}"
                                                Text="{DynamicResource NoMatchingEntries}" />
                                            <controls:ContextPreservingAccountListBox
                                                x:Name="AccountsListBox"
                                                automation:AutomationProperties.Name="{DynamicResource AccountsList}"
                                                Classes="accounts"
                                                ContextAccount="{Binding ContextAccount, Mode=TwoWay}"
                                                ItemsSource="{Binding Accounts}"
                                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding BeginContextEditCommand}" Header="{DynamicResource EditAccount}" />
                                                        <MenuItem Command="{Binding DeleteContextAccountCommand}" Header="{DynamicResource DeleteAccount}" />
                                                    </ContextMenu>
                                                </ListBox.ContextMenu>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="presentation:AccountListItemViewModel">
                                                        <Border
                                                            Classes="account-row-container"
                                                            Classes.recently-added="{Binding IsRecentlyAdded}">
                                                            <shared:AccountRow AccountName="{Binding AccountName}" Issuer="{Binding Issuer}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </controls:ContextPreservingAccountListBox>

                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                IsVisible="{Binding HasSelectedAccount}"
                                                Spacing="4">
                                                <TextBlock
                                                    Classes="issuer"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding SelectedAccount.Issuer}" />
                                                <Button
                                                    Classes="code"
                                                    Command="{Binding CopyCommand}"
                                                    IsVisible="{Binding HasGeneratedCode}"
                                                    ToolTip.Tip="{DynamicResource CopyTimedClear}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <shared:SymbolIcon IconSize="12" Kind="Copy" />
                                                        <TextBlock Text="{Binding GeneratedCode}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Classes="primary compact"
                                                    Command="{Binding GenerateCommand}"
                                                    Content="{DynamicResource GenerateCode}"
                                                    IsVisible="{Binding !HasGeneratedCode}" />
                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    IsVisible="{Binding HasGeneratedCode}">
                                                    <ProgressBar
                                                        Grid.Column="0"
                                                        Height="4"
                                                        Margin="0,0,8,0"
                                                        Maximum="{Binding PeriodSeconds}"
                                                        Minimum="0"
                                                        Value="{Binding RemainingSeconds}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Classes="countdown"
                                                        Text="{Binding RemainingSeconds}" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                IsVisible="{Binding HasSelectedAccount}"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Classes="link"
                                                    Command="{Binding BeginEditCommand}"
                                                    Content="{DynamicResource EditAccount}" />
                                                <Button
                                                    Classes="link danger-link"
                                                    Command="{Binding DeleteAccountCommand}"
                                                    Content="{DynamicResource DeleteAccount}" />
                                                <Button
                                                    Classes="link"
                                                    Command="{Binding GenerateQrCommand}"
                                                    Content="{DynamicResource ShowQrCode}" />
                                            </StackPanel>
                                            <TextBlock
                                                Classes="inline-message"
                                                IsVisible="{Binding HasCodeMessage}"
                                                Text="{Binding CodeMessage}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border
                                        x:Name="AccountMessageToast"
                                        ZIndex="10"
                                        MinWidth="180"
                                        MaxWidth="280"
                                        Margin="10,8"
                                        Padding="12,8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        automation:AutomationProperties.LiveSetting="Polite"
                                        automation:AutomationProperties.Name="{Binding Message}"
                                        Classes="account-toast"
                                        Classes.open="{Binding HasMessage}"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding HasMessage}">
                                        <Border.RenderTransform>
                                            <TranslateTransform />
                                        </Border.RenderTransform>
                                        <TextBlock
                                            Text="{Binding Message}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Border
                                        x:Name="AccountEditorFlyout"
                                        ZIndex="20"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Classes="flyout"
                                        Classes.open="{Binding IsEditorVisible}"
                                        IsVisible="{Binding IsEditorVisible}"
                                        PropertyChanged="AccountEditorFlyoutPropertyChanged">
                                        <Border.RenderTransform>
                                            <TranslateTransform />
                                        </Border.RenderTransform>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="18" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingExistingAccount}"
                                                        Text="{DynamicResource EditAccount}" />
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding !IsEditingExistingAccount}"
                                                        Text="{DynamicResource AddAccount}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Classes="icon"
                                                        Command="{Binding CancelEditCommand}"
                                                        Content="✕" />
                                                </Grid>
                                                <TextBox
                                                    x:Name="AccountIssuerBox"
                                                    automation:AutomationProperties.Name="{DynamicResource Issuer}"
                                                    PlaceholderText="{DynamicResource Issuer}"
                                                    Text="{Binding EditorIssuer, Mode=TwoWay}" />
                                                <TextBox
                                                    automation:AutomationProperties.Name="{DynamicResource AccountName}"
                                                    PlaceholderText="{DynamicResource AccountName}"
                                                    Text="{Binding EditorAccountName, Mode=TwoWay}" />
                                                <shared:RevealableSecretInput
                                                    AccessibleName="{DynamicResource Secret}"
                                                    HelpText="{DynamicResource AccountSecretInvalid}"
                                                    IsRequired="True"
                                                    PlaceholderText="{DynamicResource Secret}"
                                                    Text="{Binding EditorSecret, Mode=TwoWay}" />
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorMessage}" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                    <Button Command="{Binding CancelEditCommand}" Content="{DynamicResource CancelEdit}" />
                                                    <Button Classes="primary" Command="{Binding SaveAccountCommand}" Content="{DynamicResource SaveAccount}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <ScrollViewer
                        IsVisible="{Binding IsToolsVisible}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="14">
                            <TextBlock Classes="page-title" Text="{DynamicResource Tools}" />
                            <ContentControl Content="{Binding CameraScanner}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:CameraScannerViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ScanQrCamera}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="primary" Command="{Binding StartCommand}" Content="{DynamicResource ScanQrCamera}" />
                                                    <Button Command="{Binding CancelCommand}" Content="{DynamicResource CancelScan}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <Image
                                                    Width="280"
                                                    Height="210"
                                                    IsVisible="{Binding HasPreview}"
                                                    Source="{Binding PreviewImage}"
                                                    Stretch="Uniform" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        Margin="10,8,10,10"
                        Classes="settings-page"
                        IsVisible="{Binding IsSettingsVisible}"
                        RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="page-title" Text="{DynamicResource Settings}" />
                            <Button
                                Grid.Column="1"
                                Classes="icon"
                                Command="{Binding CloseSettingsCommand}"
                                Content="✕"
                                ToolTip.Tip="{DynamicResource CloseSettings}" />
                        </Grid>
                        <TabControl Grid.Row="1" Margin="0,8,0,0" Classes="settings-tabs">
                            <TabItem Header="{DynamicResource Security}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Margin="4,8" Content="{Binding AuthorizationSettings}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="presentation:AuthorizationSettingsViewModel">
                                                <StackPanel Spacing="12">
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource QuickUnlock}" />
                                                            <TextBlock Classes="secondary" Text="{DynamicResource QuickUnlockRecoveryNotice}" TextWrapping="Wrap" />
                                                            <shared:NotificationBanner Severity="{Binding MessageSeverity}" Text="{Binding Message}" />
                                                            <StackPanel Spacing="6">
                                                                <RadioButton
                                                                    Command="{Binding EnableQuickUnlockCommand}"
                                                                    Content="{DynamicResource QuickUnlockAtStartup}"
                                                                    GroupName="StartupUnlockMethod"
                                                                    IsChecked="{Binding IsQuickUnlockEnabled, Mode=OneWay}" />
                                                                <RadioButton
                                                                    Command="{Binding UsePasswordCommand}"
                                                                    Content="{DynamicResource UsePasswordAtStartup}"
                                                                    GroupName="StartupUnlockMethod"
                                                                    IsChecked="{Binding !IsQuickUnlockEnabled, Mode=OneWay}" />
                                                            </StackPanel>
                                                            <Button
                                                                Command="{Binding RefreshCommand}"
                                                                Content="{DynamicResource Retry}"
                                                                IsVisible="{Binding ShowQuickUnlockRetry}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource ChangeMasterPassword}" />
                                                            <shared:RevealableSecretInput AccessibleName="{DynamicResource NewPassword}" PlaceholderText="{DynamicResource NewPassword}" Text="{Binding NewPassword, Mode=TwoWay}" />
                                                            <shared:RevealableSecretInput AccessibleName="{DynamicResource ConfirmPassword}" PlaceholderText="{DynamicResource ConfirmPassword}" Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                                            <Button Classes="danger" Command="{Binding ChangePasswordCommand}" Content="{DynamicResource ChangeMasterPassword}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource RecoveryAndCompatibility}" />
                                                            <TextBlock Text="{DynamicResource PortableEnvelopeStatus}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="secondary" Text="{DynamicResource AutomaticRollbackStatus}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="secondary" Text="{DynamicResource LegacyMigrationStatus}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource ImportExport}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Margin="4,8" Content="{Binding NativeFilePicker}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                                                <StackPanel VerticalAlignment="Top" Spacing="12">
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource ImportAccounts}" />
                                                            <TextBlock Classes="settings-label" Text="{DynamicResource ImportConflictHandling}" />
                                                            <ComboBox ItemsSource="{Binding ConflictStrategies}" SelectedItem="{Binding SelectedConflictStrategyOption, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="presentation:NativeFilePickerViewModel+ImportStrategyOption">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button
                                                                Command="{Binding ImportCommand}"
                                                                Content="{DynamicResource ChooseImportFile}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource EncryptedBackup}" />
                                                            <TextBlock
                                                                Classes="secondary"
                                                                Text="{DynamicResource EncryptedBackupHelp}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Command="{Binding ExportCommand}"
                                                                Content="{DynamicResource ExportEncryptedBackup}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource Miscellaneous}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Margin="4,8" Content="{Binding SettingsPage}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                                <Border Classes="panel">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Classes="settings-label" Text="{DynamicResource Language}" />
                                                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="localization:LanguageOption">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Image Width="24" Height="18" Source="{Binding Icon}" Stretch="Uniform" />
                                                                        <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Classes="settings-label" Text="{DynamicResource IdleTimeout}" />
                                                        <NumericUpDown Maximum="1440" Minimum="0" Value="{Binding IdleTimeoutMinutes, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource LockWhenMinimized}" IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource LockOnSessionLock}" IsChecked="{Binding LockOnSessionLock, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource ClearClipboard}" IsChecked="{Binding ClearClipboardEnabled, Mode=TwoWay}" />
                                                        <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource ClipboardClearSeconds}" />
                                                        <NumericUpDown Maximum="300" Minimum="1" Value="{Binding ClearClipboardSeconds, Mode=TwoWay}" />
                                                        <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource QrPreviewScale}" />
                                                        <NumericUpDown Increment="0.5" Maximum="6" Minimum="1" Value="{Binding QrPreviewScaleFactor, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource EncryptExports}" IsChecked="{Binding ExportEncrypt, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource OpenExportAfter}" IsChecked="{Binding OpenExportFileAfterExport, Mode=TwoWay}" />
                                                        <CheckBox Content="{DynamicResource HideSecretsDefault}" IsChecked="{Binding HideSecretsByDefault, Mode=TwoWay}" />
                                                        <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource LoggingLevel}" />
                                                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay}" />
                                                        <TextBlock Classes="secondary" Text="{DynamicResource SettingsAutoSaveHint}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{DynamicResource About}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,8" Spacing="12">
                                        <ContentControl Content="{Binding SettingsPage}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource About}" />
                                                            <TextBlock Text="{Binding VersionText}" />
                                                            <Button Command="{Binding OpenLogFolderCommand}" Content="{DynamicResource OpenLogFolder}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <ContentControl Content="{Binding UpdateCheck}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="presentation:UpdateCheckViewModel">
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource SoftwareUpdates}" />
                                                            <shared:NotificationBanner Severity="{Binding MessageSeverity}" Text="{Binding Message}" />
                                                            <ProgressBar
                                                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                IsVisible="{Binding IsDownloadInProgress}"
                                                                Maximum="100"
                                                                Value="{Binding ProgressPercentage}" />
                                                            <Button
                                                                Command="{Binding CheckCommand}"
                                                                Content="{DynamicResource VerifyAppcast}"
                                                                IsVisible="{Binding ShowCheckAction}" />
                                                            <Button
                                                                Command="{Binding DownloadCommand}"
                                                                Content="{DynamicResource DownloadUpdate}"
                                                                IsVisible="{Binding ShowDownloadAction}" />
                                                            <Button
                                                                Command="{Binding InstallCommand}"
                                                                Content="{DynamicResource InstallUpdate}"
                                                                IsVisible="{Binding ShowInstallAction}" />
                                                            <Button
                                                                Command="{Binding CancelCommand}"
                                                                Content="{DynamicResource Cancel}"
                                                                IsVisible="{Binding ShowCancelAction}" />
                                                            <TextBlock IsVisible="{Binding HasReleaseNotes}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <ContentControl Content="{Binding Diagnostics}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="presentation:DiagnosticsViewModel">
                                                    <Border Classes="panel">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="section-title" Text="{DynamicResource SupportDiagnostics}" />
                                                            <Button Command="{Binding RefreshCommand}" Content="{DynamicResource RefreshSupportInformation}" />
                                                            <TextBox AcceptsReturn="True" IsReadOnly="True" MinHeight="100" Text="{Binding SupportInformation}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </shared:BusyOverlay>
</Window>
