<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    x:DataType="presentation:MainWindowViewModel"
    Title="TOTP Manager (Avalonia Preview)"
    Width="960"
    Height="640"
    MinWidth="640"
    MinHeight="480">
    <StackPanel
        Width="560"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="20">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="24"
            Text="TOTP Manager" />
        <TextBlock
            HorizontalAlignment="Center"
            Text="{Binding StatusText}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            HorizontalAlignment="Center"
            Command="{Binding InitializeCommand}"
            Content="Retry"
            IsVisible="{Binding CanRetry}" />
        <Border IsVisible="{Binding IsPasswordUnlockVisible}">
            <ContentControl Content="{Binding PasswordUnlock}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                        <StackPanel Spacing="12">
                            <TextBox
                                PasswordChar="●"
                                PlaceholderText="Master password"
                                Text="{Binding Password, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="Crimson"
                                IsVisible="{Binding HasMessage}"
                                Text="{Binding Message}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding UnlockCommand}"
                                Content="Unlock" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </StackPanel>
</Window>
