<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:MainWindowViewModel"
    Title="TOTP Manager (Avalonia Preview)"
    Width="960"
    Height="640"
    MinWidth="640"
    MinHeight="480">
    <shared:BusyOverlay
        BusyMessage="Starting TOTP Manager safely…"
        IsBusy="{Binding IsBusy}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="720"
            Margin="{DynamicResource PagePadding}"
            HorizontalAlignment="Center"
            Spacing="20">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="1"
            Classes="title"
            HorizontalAlignment="Center"
            Text="TOTP Manager" />
        <TextBlock
            automation:AutomationProperties.LiveSetting="Polite"
            Classes="secondary"
            HorizontalAlignment="Center"
            Text="{Binding StatusText}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            HorizontalAlignment="Center"
            Command="{Binding InitializeCommand}"
            Content="Retry"
            IsVisible="{Binding CanRetry}" />
        <Border Classes="card" IsVisible="{Binding IsPasswordUnlockVisible}">
            <ContentControl Content="{Binding PasswordUnlock}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                        <StackPanel Spacing="12">
                            <TextBox
                                automation:AutomationProperties.HelpText="Required to unlock the local synthetic vault."
                                automation:AutomationProperties.Name="Master password"
                                automation:AutomationProperties.IsRequiredForForm="True"
                                PasswordChar="●"
                                PlaceholderText="Master password"
                                Text="{Binding Password, Mode=TwoWay}" />
                            <shared:ValidationMessage
                                HorizontalAlignment="Center"
                                Severity="Error"
                                Text="{Binding Message}" />
                            <Button
                                Classes="primary"
                                HorizontalAlignment="Center"
                                Command="{Binding UnlockCommand}"
                                Content="Unlock" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        <Button
            Classes="danger"
            HorizontalAlignment="Right"
            Command="{Binding LockCommand}"
            Content="Lock"
            IsVisible="{Binding IsShellVisible}" />
        <Border Classes="card" IsVisible="{Binding IsShellVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    automation:AutomationProperties.Name="Open accounts page"
                    Command="{Binding ShowAccountsCommand}"
                    Content="Accounts" />
                <Button
                    automation:AutomationProperties.Name="Open tools page"
                    Command="{Binding ShowToolsCommand}"
                    Content="Tools" />
                <Button
                    automation:AutomationProperties.Name="Open settings page"
                    Command="{Binding ShowSettingsCommand}"
                    Content="Settings" />
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsToolsVisible}">
            <StackPanel Spacing="16">
                <TextBlock Classes="heading" Text="Tools" />
                <ContentControl Content="{Binding NativeFilePicker}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                    <StackPanel Spacing="6">
                        <Button Command="{Binding PickCommand}" Content="Choose import file…" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
                <ContentControl Content="{Binding UpdateCheck}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:UpdateCheckViewModel">
                    <StackPanel Spacing="6">
                        <Button Command="{Binding CheckCommand}" Content="Verify signed test appcast" />
                        <TextBlock
                            automation:AutomationProperties.LiveSetting="Polite"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
                <ContentControl Content="{Binding CameraScanner}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:CameraScannerViewModel">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding StartCommand}" Content="Scan QR with camera" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel scan" />
                        </StackPanel>
                        <TextBlock
                            automation:AutomationProperties.LiveSetting="Polite"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                        <Image
                            automation:AutomationProperties.Name="Live camera preview"
                            Width="320"
                            Height="240"
                            IsVisible="{Binding HasPreview}"
                            Source="{Binding PreviewImage}"
                            Stretch="Uniform" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsSettingsVisible}">
            <ContentControl Content="{Binding SettingsPage}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="heading" Text="Security settings" />
                            <TextBlock Text="Idle timeout in minutes (0 disables idle lock)" />
                            <NumericUpDown
                                automation:AutomationProperties.HelpText="Enter zero to disable idle locking."
                                automation:AutomationProperties.Name="Idle timeout in minutes"
                                Maximum="1440"
                                Minimum="0"
                                Value="{Binding IdleTimeoutMinutes, Mode=TwoWay}" />
                            <CheckBox
                                Content="Lock when minimized"
                                IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                            <Button Command="{Binding SaveCommand}" Content="Save settings" />
                            <TextBlock Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsAccountListVisible}">
            <ContentControl Content="{Binding AccountList}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:AccountListViewModel">
                        <StackPanel Spacing="12">
                            <TextBox
                                automation:AutomationProperties.Name="Search accounts"
                                PlaceholderText="Search issuer or account"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                            <TextBlock
                                automation:AutomationProperties.LiveSetting="Polite"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasMessage}"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                            <ListBox
                                automation:AutomationProperties.Name="Accounts"
                                MaxHeight="420"
                                ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:AccountListItemViewModel">
                                        <Grid Margin="8" ColumnDefinitions="2*,3*">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Issuer}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding AccountName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button
                                Classes="primary"
                                HorizontalAlignment="Center"
                                Command="{Binding GenerateCommand}"
                                Content="Generate code" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding GenerateQrCommand}"
                                Content="Show QR code" />
                            <TextBlock
                                automation:AutomationProperties.Name="Generated one-time code"
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="28"
                                IsVisible="{Binding HasGeneratedCode}"
                                Text="{Binding GeneratedCode}" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding CopyCommand}"
                                Content="Copy with timed clear"
                                IsVisible="{Binding HasGeneratedCode}" />
                            <TextBlock
                                automation:AutomationProperties.LiveSetting="Polite"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasCodeMessage}"
                                Text="{Binding CodeMessage}" />
                            <Image
                                automation:AutomationProperties.Name="Generated account QR code"
                                Width="240"
                                Height="240"
                                IsVisible="{Binding HasQrImage}"
                                Source="{Binding QrImage}"
                                Stretch="Uniform" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        </StackPanel>
        </ScrollViewer>
    </shared:BusyOverlay>
</Window>
