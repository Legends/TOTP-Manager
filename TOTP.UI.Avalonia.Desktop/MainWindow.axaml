<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    x:DataType="presentation:MainWindowViewModel"
    Title="TOTP Manager (Avalonia Preview)"
    Width="960"
    Height="640"
    MinWidth="640"
    MinHeight="480">
    <StackPanel
        Width="560"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="20">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="24"
            Text="TOTP Manager" />
        <TextBlock
            HorizontalAlignment="Center"
            Text="{Binding StatusText}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            HorizontalAlignment="Center"
            Command="{Binding InitializeCommand}"
            Content="Retry"
            IsVisible="{Binding CanRetry}" />
    </StackPanel>
</Window>
