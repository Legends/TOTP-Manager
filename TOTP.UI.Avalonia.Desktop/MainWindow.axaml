<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource AppTitle}"
    Width="960"
    Height="640"
    MinWidth="640"
    MinHeight="480"
    Icon="/Assets/Icons/app.ico">
    <shared:BusyOverlay
        BusyMessage="{DynamicResource StartingSafely}"
        IsBusy="{Binding IsBusy}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="720"
            Margin="{DynamicResource PagePadding}"
            HorizontalAlignment="Center"
            Spacing="20">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="1"
            Classes="title"
            HorizontalAlignment="Center"
            Text="{DynamicResource AppHeading}" />
        <shared:NotificationBanner
            HorizontalAlignment="Center"
            MaxWidth="640"
            Severity="{Binding StatusSeverity}"
            Text="{Binding StatusText}" />
        <Button
            HorizontalAlignment="Center"
            Command="{Binding InitializeCommand}"
            Content="{DynamicResource Retry}"
            IsVisible="{Binding CanRetry}" />
        <Border Classes="card" IsVisible="{Binding IsPasswordUnlockVisible}">
            <ContentControl Content="{Binding PasswordUnlock}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                        <StackPanel Spacing="12">
                            <shared:RevealableSecretInput
                                AccessibleName="{DynamicResource MasterPassword}"
                                HelpText="{DynamicResource MasterPasswordHelp}"
                                IsRequired="True"
                                PlaceholderText="{DynamicResource MasterPassword}"
                                Text="{Binding Password, Mode=TwoWay}" />
                            <shared:ValidationMessage
                                HorizontalAlignment="Center"
                                Severity="Error"
                                Text="{Binding Message}" />
                            <Button
                                Classes="primary"
                                HorizontalAlignment="Center"
                                Command="{Binding UnlockCommand}"
                                Content="{DynamicResource Unlock}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        <Button
            Classes="danger"
            HorizontalAlignment="Right"
            Command="{Binding LockCommand}"
            IsVisible="{Binding IsShellVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <shared:SymbolIcon Kind="Lock" Foreground="{DynamicResource BrushOnDanger}" />
                <TextBlock Text="{DynamicResource Lock}" />
            </StackPanel>
        </Button>
        <Border Classes="card" IsVisible="{Binding IsShellVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    automation:AutomationProperties.Name="{DynamicResource NavAccounts}"
                    Command="{Binding ShowAccountsCommand}"
                    Content="{DynamicResource Accounts}" />
                <Button
                    automation:AutomationProperties.Name="{DynamicResource NavTools}"
                    Command="{Binding ShowToolsCommand}"
                    Content="{DynamicResource Tools}" />
                <Button
                    automation:AutomationProperties.Name="{DynamicResource NavSettings}"
                    Command="{Binding ShowSettingsCommand}"
                    Content="{DynamicResource Settings}" />
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsToolsVisible}">
            <StackPanel Spacing="16">
                <TextBlock Classes="heading" Text="{DynamicResource Tools}" />
                <ContentControl Content="{Binding NativeFilePicker}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                    <StackPanel Spacing="6">
                        <Button Command="{Binding PickCommand}" Content="{DynamicResource ChooseImportFile}" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
                <ContentControl Content="{Binding UpdateCheck}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:UpdateCheckViewModel">
                    <StackPanel Spacing="6">
                        <Button Command="{Binding CheckCommand}" Content="{DynamicResource VerifyAppcast}" />
                        <TextBlock
                            automation:AutomationProperties.LiveSetting="Polite"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
                <ContentControl Content="{Binding CameraScanner}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:CameraScannerViewModel">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding StartCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <shared:SymbolIcon Kind="Camera" />
                                    <TextBlock Text="{DynamicResource ScanQrCamera}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" Content="{DynamicResource CancelScan}" />
                        </StackPanel>
                        <TextBlock
                            automation:AutomationProperties.LiveSetting="Polite"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                        <Image
                            automation:AutomationProperties.Name="{DynamicResource CameraPreview}"
                            Width="320"
                            Height="240"
                            IsVisible="{Binding HasPreview}"
                            Source="{Binding PreviewImage}"
                            Stretch="Uniform" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsSettingsVisible}">
            <ContentControl Content="{Binding SettingsPage}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="heading" Text="{DynamicResource SecuritySettings}" />
                            <TextBlock Text="{DynamicResource Language}" />
                            <ComboBox
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="localization:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource IdleTimeout}" />
                            <NumericUpDown
                                automation:AutomationProperties.HelpText="{DynamicResource IdleTimeoutHelp}"
                                automation:AutomationProperties.Name="Idle timeout in minutes"
                                Maximum="1440"
                                Minimum="0"
                                Value="{Binding IdleTimeoutMinutes, Mode=TwoWay}" />
                            <CheckBox
                                Content="{DynamicResource LockWhenMinimized}"
                                IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                            <Button Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <shared:SymbolIcon Kind="Settings" />
                                    <TextBlock Text="{DynamicResource SaveSettings}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsAccountListVisible}">
            <ContentControl Content="{Binding AccountList}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:AccountListViewModel">
                        <StackPanel Spacing="12">
                            <TextBox
                                automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                PlaceholderText="{DynamicResource SearchAccounts}"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                            <TextBlock
                                automation:AutomationProperties.LiveSetting="Polite"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasMessage}"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                            <ListBox
                                automation:AutomationProperties.Name="{DynamicResource AccountsList}"
                                MaxHeight="420"
                                ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:AccountListItemViewModel">
                                        <shared:AccountRow
                                            AccountName="{Binding AccountName}"
                                            Issuer="{Binding Issuer}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button
                                Classes="primary"
                                HorizontalAlignment="Center"
                                Command="{Binding GenerateCommand}"
                                Content="{DynamicResource GenerateCode}" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding GenerateQrCommand}"
                                Content="{DynamicResource ShowQrCode}" />
                            <TextBlock
                                automation:AutomationProperties.Name="{DynamicResource GeneratedCode}"
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="28"
                                IsVisible="{Binding HasGeneratedCode}"
                                Text="{Binding GeneratedCode}" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding CopyCommand}"
                                IsVisible="{Binding HasGeneratedCode}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <shared:SymbolIcon Kind="Copy" />
                                    <TextBlock Text="{DynamicResource CopyTimedClear}" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                automation:AutomationProperties.LiveSetting="Polite"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasCodeMessage}"
                                Text="{Binding CodeMessage}" />
                            <shared:QrPreview
                                Description="{DynamicResource GeneratedQr}"
                                PrivacyNotice="{DynamicResource QrPrivacyNotice}"
                                Source="{Binding QrImage}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        </StackPanel>
        </ScrollViewer>
    </shared:BusyOverlay>
</Window>
