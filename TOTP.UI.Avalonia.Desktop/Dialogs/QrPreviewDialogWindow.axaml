<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.QrPreviewDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:QrPreviewDialogViewModel"
    MinWidth="320"
    MinHeight="390"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource GeneratedQr}">
    <Grid Margin="16" RowDefinitions="*,Auto">
        <Border
            Background="{DynamicResource BrushQrBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
            <Image
                automation:AutomationProperties.Name="{DynamicResource GeneratedQr}"
                Source="{Binding Image}"
                Stretch="Uniform" />
        </Border>
        <shared:ValidationMessage
            Grid.Row="1"
            Margin="0,12,0,0"
            Severity="Warning"
            Text="{DynamicResource QrPrivacyNotice}"
            TextAlignment="Center" />
    </Grid>
</Window>
