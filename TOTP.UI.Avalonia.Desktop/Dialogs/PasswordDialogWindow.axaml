<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.PasswordDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="dialogs:PasswordDialogViewModel"
    Classes="dialog"
    Title="{Binding Title}">
    <shared:BusyOverlay
        BusyMessage="{DynamicResource ValidatingSecurely}"
        IsBusy="{Binding IsBusy}">
        <StackPanel Classes="dialog-content">
            <TextBlock
                Classes="heading"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="secondary"
                Text="{Binding Message}"
                TextWrapping="Wrap" />
            <shared:RevealableSecretInput
                AccessibleName="{DynamicResource Password}"
                HelpText="{DynamicResource PasswordAuthorizationHelp}"
                IsRequired="True"
                PlaceholderText="{DynamicResource Password}"
                Text="{Binding Password, Mode=TwoWay}" />
            <shared:ValidationMessage
                Severity="Error"
                Text="{Binding ErrorMessage}" />
            <StackPanel
                Classes="dialog-actions">
                <Button
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    Content="{Binding CancelText}"
                    IsCancel="True" />
                <Button
                    Classes="primary"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </shared:BusyOverlay>
</Window>
