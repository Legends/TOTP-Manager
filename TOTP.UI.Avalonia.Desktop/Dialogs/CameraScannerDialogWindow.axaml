<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.CameraScannerDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    x:DataType="presentation:CameraScannerViewModel"
    Width="560"
    Height="420"
    MinWidth="420"
    MinHeight="320"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource ScanQrCamera}">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock
            Classes="page-title"
            Text="{DynamicResource ScanQrCamera}" />
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image
                    automation:AutomationProperties.Name="{DynamicResource CameraPreview}"
                    IsVisible="{Binding HasPreview}"
                    Source="{Binding PreviewImage}"
                    Stretch="Uniform" />
                <ProgressBar
                    Width="180"
                    Height="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    IsVisible="{Binding !HasPreview}" />
            </Grid>
        </Border>
        <TextBlock
            Grid.Row="2"
            Margin="0,10,0,0"
            Classes="secondary"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
        <Button
            Grid.Row="3"
            Width="110"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Command="{Binding CancelCommand}"
            Content="{DynamicResource CancelScan}"
            IsCancel="True" />
    </Grid>
</Window>
