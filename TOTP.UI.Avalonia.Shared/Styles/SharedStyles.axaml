<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Shared.Controls">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#B42318" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#8A4B00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#137333" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#005FCC" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#B42318" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#8A4B00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#137333" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#005FCC" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#111827" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#1F2937" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#273449" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#D1D5DB" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#4B5563" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#77A7FF" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#081426" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#FF8A80" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#2A0805" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#FFD166" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#6DD58C" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#9CC2FF" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#000000" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#000000" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#000000" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#000000" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#FF8080" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#000000" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#00FF00" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#00FFFF" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="Space1">4</x:Double>
            <x:Double x:Key="Space2">8</x:Double>
            <x:Double x:Key="Space3">12</x:Double>
            <x:Double x:Key="Space4">16</x:Double>
            <x:Double x:Key="Space6">24</x:Double>
            <x:Double x:Key="Space8">32</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeHeading">20</x:Double>
            <x:Double x:Key="FontSizeTitle">28</x:Double>
            <x:Double x:Key="ControlMinimumHeight">36</x:Double>
            <x:Double x:Key="MotionFastMilliseconds">120</x:Double>
            <x:Double x:Key="MotionStandardMilliseconds">200</x:Double>
            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
            <BoxShadows x:Key="ElevationCard">0 2 8 0 #1A000000</BoxShadows>
            <Thickness x:Key="PagePadding">24</Thickness>
            <Thickness x:Key="ControlPadding">16,8</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushWindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ElevationCard}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnDanger}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
    </Style>
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="NumericUpDown:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="controls|BusyOverlay">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ContentPresenter
                        Name="PART_Content"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Border
                        automation:AutomationProperties.LiveSetting="Polite"
                        automation:AutomationProperties.Name="{TemplateBinding BusyMessage}"
                        Background="{DynamicResource BrushSurface}"
                        IsVisible="{TemplateBinding IsBusy}"
                        Opacity="0.96">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressBar
                                Width="180"
                                IsIndeterminate="True" />
                            <TextBlock
                                Classes="secondary"
                                Text="{TemplateBinding BusyMessage}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:busy /template/ ContentPresenter#PART_Content">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Style>
    <Style Selector="controls|ValidationMessage">
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock
                    Name="PART_Message"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    Text="{TemplateBinding Text}"
                    TextAlignment="{TemplateBinding TextAlignment}"
                    TextWrapping="Wrap" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|ValidationMessage:information /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="controls|ValidationMessage:warning /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
    </Style>
    <Style Selector="controls|ValidationMessage:error /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="controls|RevealableSecretInput">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox
                        Name="PART_Input"
                        automation:AutomationProperties.HelpText="{TemplateBinding HelpText}"
                        automation:AutomationProperties.IsRequiredForForm="{TemplateBinding IsRequired}"
                        automation:AutomationProperties.Name="{TemplateBinding AccessibleName}"
                        Grid.Column="0"
                        PasswordChar="●"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <Button
                        Name="PART_RevealButton"
                        automation:AutomationProperties.HelpText="The secret is concealed again when the key or pointer is released."
                        automation:AutomationProperties.Name="Hold to reveal secret"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Show"
                        ToolTip.Tip="Hold to reveal" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|QrPreview">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="8">
                    <Border
                        Background="{DynamicResource BrushQrBackground}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="8">
                        <Image
                            automation:AutomationProperties.Name="{TemplateBinding Description}"
                            Width="240"
                            Height="240"
                            Source="{TemplateBinding Source}"
                            Stretch="Uniform" />
                    </Border>
                    <controls:ValidationMessage
                        MaxWidth="320"
                        Severity="Warning"
                        Text="{TemplateBinding PrivacyNotice}"
                        TextAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|AccountRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    automation:AutomationProperties.Name="{TemplateBinding AccessibleName}"
                    ColumnDefinitions="2*,3*"
                    MinHeight="{DynamicResource ControlMinimumHeight}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{TemplateBinding Issuer}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{TemplateBinding AccountName}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|NotificationBanner">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Banner"
                    automation:AutomationProperties.LiveSetting="{TemplateBinding LiveSetting}"
                    automation:AutomationProperties.Name="{TemplateBinding Text}"
                    Background="{DynamicResource BrushSurfaceAlternate}"
                    BorderThickness="4,0,0,0"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="12,8">
                    <TextBlock
                        Text="{TemplateBinding Text}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|NotificationBanner:information /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="controls|NotificationBanner:success /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
    </Style>
    <Style Selector="controls|NotificationBanner:warning /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
    </Style>
    <Style Selector="controls|NotificationBanner:error /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
    </Style>
</Styles>
