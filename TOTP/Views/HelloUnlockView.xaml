<UserControl x:Class="TOTP.Views.HelloUnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xaml="clr-namespace:TOTP.Xaml">
    <UserControl.Resources>
        <Style x:Key="HelloUnlockButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource Brush.AccentPrimary}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Brush.BorderAccentSoft}" />
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12,6" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource Brush.AccentPrimaryHover}" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{StaticResource Brush.BorderAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource Brush.AccentPrimaryPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="260"
            Padding="18"
            Margin="0,14,0,10"
            CornerRadius="8"
            Background="{StaticResource Brush.SurfaceDialog}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="8"
                        Background="{StaticResource Brush.AccentChipBackground}"
                        BorderBrush="{StaticResource Brush.BorderAccent}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Viewbox Width="22"
                             Height="22"
                             Stretch="Uniform">
                        <Grid Width="24"
                              Height="24">
                            <Ellipse Width="17"
                                     Height="17"
                                     Stroke="{StaticResource Brush.TextPrimary}"
                                     StrokeThickness="1.8"
                                     Fill="Transparent"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Ellipse Width="2.4"
                                     Height="2.4"
                                     Fill="{StaticResource Brush.TextPrimary}"
                                     Margin="7.2,8.2,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                            <Ellipse Width="2.4"
                                     Height="2.4"
                                     Fill="{StaticResource Brush.TextPrimary}"
                                     Margin="14.4,8.2,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                            <Path Stroke="{StaticResource Brush.TextPrimary}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 8.2,14 C 10,16.2 14,16.2 15.8,14" />
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Windows Hello"
                               Style="{StaticResource TextStyle.SectionHeader}" />
                    <TextBlock Text="Verify your identity to unlock the vault."
                               Style="{StaticResource TextStyle.Subheader}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Style="{StaticResource InlineErrorTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <Button Command="{Binding UnlockCommand}"
                    Style="{StaticResource HelloUnlockButtonStyle}"
                    IsDefault="True"
                    Height="40">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
                             Margin="0,0,8,0">
                        <Grid Width="24"
                              Height="24">
                            <Ellipse Width="17"
                                     Height="17"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.8"
                                     Fill="Transparent"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Ellipse Width="2.4"
                                     Height="2.4"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     Margin="7.2,8.2,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                            <Ellipse Width="2.4"
                                     Height="2.4"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     Margin="14.4,8.2,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 8.2,14 C 10,16.2 14,16.2 15.8,14" />
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="{xaml:Resx Key=ui_UnlockWith_Hello}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
